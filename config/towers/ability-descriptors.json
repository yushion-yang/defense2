{
  "_meta": {
    "_doc": "能力描述符表。每个能力用 pipeline 模式描述其完整行为链。",
    "format": "数组形式，每项为一个 AbilityDescriptor",
    "fields": {
      "id":          "能力唯一标识，与 abilities.json 的 type 一一对应",
      "label":       "中文显示名",
      "cost":        "解锁费用",
      "tags":        "分类标签（attack/cc/damage/buff/dot/zone）",
      "attackStyle": "攻击方式覆盖（仅 attack 类能力）",
      "spriteKey":   "攻击方式对应的精灵键名（仅 attack 类能力）",
      "attackParams":"攻击方式参数（仅 attack 类能力，内含 scaler）",
      "pipelines":   "触发→条件→选择器→效果 管线数组"
    },
    "scalerTypes": {
      "fixed":  "固定值 {\"scaler\":\"fixed\",\"value\":N}",
      "linear": "线性缩放 {\"scaler\":\"linear\",\"base\":B,\"potential\":P}，公式: base + potential × (strength / 100)"
    }
  },

