[
  {"id": "idle_ext_221", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "逆风局别慌，卖掉前排塔换后排输出！", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_222", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "资源卡住了？故意漏几只小怪攒钱也行。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_223", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "散射对付密集波，光束专打Boss。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_224", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "有时候不升级，留钱造新塔更赚。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_225", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "减速能力被低估了，试试全减速阵容？", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_226", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "旋转攻击克隐身怪，记住这个搭配！", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_227", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "翻盘秘诀：把塔卖了重新布阵。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_228", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "溅射对分裂怪简直是天敌呢。", "expression": "talk", "autoAdvance": 3}], "once": false, "priority": 1},
  {"id": "idle_ext_229", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "弹射能力在窄路地图价值翻倍！", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_230", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "选能力时，控制优先于纯伤害。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_231", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "极限翻盘：只留一座塔，全力养它。", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},

  {"id": "idle_ext_232", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "嗯嗯~♪ 刚才在哼什么来着？", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_233", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "我在地上画了只小猫，你看到了吗？", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_234", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "手指好无聊，一直在转笔……", "expression": "idle", "autoAdvance": 3}], "once": false, "priority": 1},
  {"id": "idle_ext_235", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "昨晚梦见自己变成了一座塔。", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_236", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "小时候最爱玩跳房子，你呢？", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_237", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "零食排名第一：芝士薯片！不接受反驳。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_238", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "你的操作好流畅，看着好舒服~", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_239", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "啦啦啦~等待也是一种享受嘛。", "expression": "happy", "autoAdvance": 3}], "once": false, "priority": 1},
  {"id": "idle_ext_240", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "刚才在数屏幕上的像素点……", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_241", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "你闻到了吗？好像有烤红薯的味道。", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_242", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "今天你的眼神特别有光，真好看。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},

  {"id": "idle_ext_243", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "最简单的方法，往往最有效。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_244", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "重来不是失败，是带着经验再出发。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_245", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "不完美也没关系，完成比完美重要。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_246", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "习惯的力量很可怕，好的坏的都是。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_247", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "成长总是伴随着一点点不舒服呢。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_248", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "「家」不是地方，是让你放松的感觉。", "expression": "talk", "autoAdvance": 5}], "once": false, "priority": 1},
  {"id": "idle_ext_249", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "复杂不代表强大，简洁才是真功夫。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_250", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "迷路的时候，停下来也是一种前进。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_251", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "每个选择都在塑造未来的你哦。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_252", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "慢一点没关系，方向对就好。", "expression": "idle", "autoAdvance": 3}], "once": false, "priority": 1},
  {"id": "idle_ext_253", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "失去才明白拥有的珍贵，老话但是真的。", "expression": "talk", "autoAdvance": 5}], "once": false, "priority": 1},

  {"id": "idle_ext_254", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "开发者凌晨三点改Bug，心态崩了。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_255", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "据说有个功能被砍了五次才放弃。", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_256", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "给变量取名花了半小时，代码两分钟。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_257", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "代码里到处写着TODO，像许愿墙。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_258", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "Git冲突是开发者的噩梦，真的。", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_259", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "每次发布前，开发者手都在抖。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_260", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "代码审查时被指出低级错误，社死了。", "expression": "surprised", "autoAdvance": 5}], "once": false, "priority": 1},
  {"id": "idle_ext_261", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "「这个Bug不可能」——名言，每次都打脸。", "expression": "talk", "autoAdvance": 5}], "once": false, "priority": 1},
  {"id": "idle_ext_262", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "听说注释里藏着开发者的怨念。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_263", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "改一行代码，崩了三个功能，经典。", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_264", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "开发者说最满意的代码是删掉的那些。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},

  {"id": "idle_ext_265", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "地图边界外面，其实还有一片森林哦。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_266", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "退役的塔会去哪里？听说有个养老院。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_267", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "小怪们其实有自己的幼儿园呢。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_268", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "这个世界也有春节，塔上会挂灯笼。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_269", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "你关掉游戏后，我会在这里等你回来。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_270", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "平行世界里，也许怪物在守塔防人类。", "expression": "surprised", "autoAdvance": 5}], "once": false, "priority": 1},
  {"id": "idle_ext_271", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "Boss下班后会去泡温泉，我偷看到的。", "expression": "happy", "autoAdvance": 5}], "once": false, "priority": 1},
  {"id": "idle_ext_272", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "地图下面藏着古代遗迹，没人挖过。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_273", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "怪物们有工会，加班要付加班费的。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_274", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "游戏关闭时，所有角色会一起看星星。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_275", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "听说第九张地图在云端，还没造好。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},

  {"id": "idle_ext_276", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "敢不敢挑战极限难度？我赌你过不了。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_277", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "我赌五毛钱你下一波要漏怪。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_278", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "选手正在思考！观众们屏住了呼吸！", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_279", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "本局评分：犹豫度S，果断度D。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_280", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "你的决策速度……嗯，需要加速。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_281", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "来嘛来嘛，试试只造两座塔通关！", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_282", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "漂亮！这波操作我给9.5分！", "expression": "happy", "autoAdvance": 3}], "once": false, "priority": 1},
  {"id": "idle_ext_283", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "选手陷入了沉思……裁判要计时了哦。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_284", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "不敢赌？那我就默认你怕了~", "expression": "happy", "autoAdvance": 3}], "once": false, "priority": 1},
  {"id": "idle_ext_285", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "零漏怪通关？做到了我叫你大佬！", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_286", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "最后一条命了还这么淡定，佩服佩服。", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},

  {"id": "idle_ext_287", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "新手别怕犯错，每一局都是学习~", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_288", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "第一次玩？先随便造塔感受一下！", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_289", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "新手常见错误：塔铺太多，每座都弱。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_290", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "少造几座塔，集中养强更好用哦。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_291", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "输了也别灰心，换个布局再来！", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_292", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "路口交汇处放塔，覆盖面最大。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_293", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "多试试不同能力组合，会有惊喜的。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_294", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "注意看怪物类型，对症下药很重要。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_295", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "留点钱应急，别一次花光所有金币。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_296", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "失败是正常的，我第一次也没过关呢。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_297", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "大胆实验！最坏不过重来一局嘛。", "expression": "happy", "autoAdvance": 3}], "once": false, "priority": 1},

  {"id": "idle_ext_298", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "谢谢你来玩，真的很开心。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_299", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "有你在，我就不是一个人了。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_300", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "晚了就早点休息，游戏明天还在。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_301", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "节日快乐呀，不管今天是不是节日。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_302", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "你在这里，就是最好的事情。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_303", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "今天辛苦了，在这里放松一下吧。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_304", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "下雨天适合窝在家里打游戏呢。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_305", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "不管打得好不好，陪着你就够了。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_306", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "希望你今晚做个好梦~", "expression": "happy", "autoAdvance": 3}], "once": false, "priority": 1},
  {"id": "idle_ext_307", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "累了就歇一会儿，我哪儿也不去。", "expression": "idle", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_308", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "你知道吗，你笑起来特别好看。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},

  {"id": "idle_ext_309", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "如果这是RPG，我就是你的队友了。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_310", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "要是FPS视角，站在塔顶往下看好刺激！", "expression": "surprised", "autoAdvance": 5}], "once": false, "priority": 1},
  {"id": "idle_ext_311", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "益智版：把怪物推进方块里消除！", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_312", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "音游版：踩着节拍放技能，想想就燃！", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_313", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "改编动画的话，Boss篇肯定最好看。", "expression": "talk", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_314", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "真人电影版，Boss得请巨石强森演。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_315", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "小怪发朋友圈：「又加班冲塔了」。", "expression": "happy", "autoAdvance": 4}], "once": false, "priority": 1},
  {"id": "idle_ext_316", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "如果拿年度最佳，我的获奖感言都想好了！", "expression": "happy", "autoAdvance": 5}], "once": false, "priority": 1},
  {"id": "idle_ext_317", "scene": "*", "trigger": "idle_chatter", "lines": [{"text": "格斗版：塔和Boss一对一单挑！", "expression": "surprised", "autoAdvance": 4}], "once": false, "priority": 1},
