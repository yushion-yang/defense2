    "once": false,
    "priority": 1
  },
  {
    "id": "idle_chatter_58",
    "scene": "*",
    "trigger": "idle_chatter",
    "lines": [
      {"text": "你看到的每一个像素...", "expression": "idle", "autoAdvance": 3},
      {"text": "都是有人一点点调出来的。想想还挺浪漫的。", "expression": "talk", "autoAdvance": 5}
