    "priority": 1
  },
  {
    "id": "idle_chatter_54",
    "scene": "*",
    "trigger": "idle_chatter",
    "lines": [
      {"text": "我偷偷观察了一下...", "expression": "idle", "autoAdvance": 3},
      {"text": "你好像有自己固定的打法了？", "expression": "talk", "autoAdvance": 4},
      {"text": "要不要试试完全不同的策略？", "expression": "happy", "autoAdvance": 4}
