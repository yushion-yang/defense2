    "once": false,
    "priority": 1
  },
  {
    "id": "idle_chatter_50",
    "scene": "*",
    "trigger": "idle_chatter",
    "lines": [
      {"text": "你觉得这个游戏最难的地方是什么？", "expression": "idle", "autoAdvance": 4},
      {"text": "我觉得是...选择。", "expression": "talk", "autoAdvance": 4},
      {"text": "建在哪，升哪座，选什么能力，全是选择。", "expression": "idle", "autoAdvance": 5}
    ],
    "once": false,
    "priority": 1
  },
  {
    "id": "idle_chatter_51",
    "scene": "*",
    "trigger": "idle_chatter",
    "lines": [
      {"text": "听说把道具攒到Boss波再用，效果翻倍？", "expression": "talk", "autoAdvance": 4},
