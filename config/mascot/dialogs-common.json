    "once": false,
    "priority": 1
  },
  {
    "id": "idle_chatter_55",
    "scene": "*",
    "trigger": "idle_chatter",
    "lines": [
      {"text": "狂暴的敌人血少了会突然变快！", "expression": "talk", "autoAdvance": 4},
