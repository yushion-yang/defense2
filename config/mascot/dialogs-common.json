    "once": false,
    "priority": 1
  },
  {
    "id": "idle_chatter_53",
    "scene": "*",
    "trigger": "idle_chatter",
    "lines": [
      {"text": "塔的强度(Strength)决定一切。", "expression": "talk", "autoAdvance": 4},
