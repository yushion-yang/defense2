{
  "_meta": {
    "description": "Tower visual descriptions for generate-assets.mjs -- multi-frame SVG + PNG",
    "type": "tower",
    "viewBox": "0 0 128 128",
    "outputSize": 128,
    "animations": {
      "idle": { "frames": 2, "fps": 2 },
      "attack": { "frames": 3, "fps": 8 }
    },
    "naming": {
      "sentinel": "basic tower (no ability chosen yet)",
      "fortress": "enhance -- all stats boost",
      "shotgun":  "scatter -- cone pellets",
      "prism":    "wideBeam -- penetrating beam",
      "cyclone":  "spinAoe -- spinning area damage",
      "railgun":  "projectile -- long-range sniper shots",
      "ricochet": "bounce -- chain lightning bounces",
      "mortar":   "splash -- area explosion",
      "hydra":    "multiTarget -- simultaneous multi-target",
      "nova":     "radial -- 360-degree burst"
    }
  },

  "sentinel": {
    "name": "Sentinel",
    "label": "哨兵",
    "description": "Simple grey-white watchtower. Clean circular base with a single slim barrel, minimal adornment. The starting tower before any ability is chosen.",
    "palette": {
      "primary": "#94a3b8",
      "secondary": "#64748b",
      "accent": "#cbd5e1",
      "dark": "#334155",
      "glow": "#94a3b8",
      "highlight": "#e2e8f0"
    },
    "base": {
      "type": "circle",
      "cx": 64, "cy": 80, "r": 34,
      "gradient": { "type": "radial", "stops": [
        { "offset": "0%", "color": "#64748b" },
        { "offset": "70%", "color": "#475569" },
        { "offset": "100%", "color": "#334155" }
      ]},
      "stroke": "#94a3b8", "strokeWidth": 1.5,
      "innerRing": { "r": 24, "stroke": "#475569", "strokeWidth": 1, "opacity": 0.4 }
    },
    "turret": {
      "type": "barrel",
      "rect": { "x": 58, "y": 32, "width": 12, "height": 38, "rx": 3 },
      "gradient": { "type": "linear", "y1": "0%", "y2": "100%", "stops": [
        { "offset": "0%", "color": "#94a3b8" },
        { "offset": "100%", "color": "#334155" }
      ]},
      "lens": { "cx": 64, "cy": 30, "r": 6, "color": "#cbd5e1", "opacity": 0.85,
        "innerR": 3, "innerColor": "#e2e8f0" }
    },
    "core": {
      "cx": 64, "cy": 68, "r": 4,
      "color": "#cbd5e1", "opacity": 0.8,
      "innerR": 2, "innerColor": "#e2e8f0"
    },
    "effects": [
      { "type": "glow-halo", "cx": 64, "cy": 30, "r": 12, "color": "#94a3b8", "opacity": 0.2 }
    ],
    "animations": {
      "idle": { "transforms": [
        { "target": "core", "property": "opacity", "values": [0.8, 0.5] },
        { "target": "effects", "property": "opacity", "values": [0.2, 0.1] }
      ]},
      "attack": { "transforms": [
        { "target": "turret", "property": "translateY", "values": [0, -3, 1] },
        { "target": "effects", "property": "opacity", "values": [0.2, 0.8, 0.15] }
      ]}
