  "transitionRules": {
    "_doc": "BGM 切换规则，描述各场景/事件间的 BGM 流转",
    "flow": [
      {
        "from": "silence",
        "to": "bgm-menu",
        "trigger": "游戏启动 → 进入 SelectScene",
        "transition": "直接播放（无淡入淡出）"
      },
      {
        "from": "bgm-menu",
        "to": "bgm-battle",
        "trigger": "SelectScene → StageScene（开始战斗）",
        "transition": "直接切换（新 PlayBGM 替换旧 BGM）"
      },
      {
        "from": "bgm-battle",
        "to": "bgm-boss",
        "trigger": "Boss 波次开始（EvtWaveStarted + hasBoss）",
        "transition": "直接切换"
      },
      {
        "from": "bgm-boss",
        "to": "bgm-battle",
        "trigger": "Boss 波次清除（waveClear + 还有后续波次）",
        "transition": "直接切换"
      },
      {
        "from": "bgm-battle|bgm-boss",
        "to": "silence",
        "trigger": "胜利或失败（endgame）",
        "transition": "StopBGM() 直接停止"
      },
      {
        "from": "silence",
        "to": "bgm-menu",
        "trigger": "结算 → 返回 SelectScene",
        "transition": "直接播放"
      }
    ],
    "pauseBehavior": {
      "description": "暂停菜单期间 BGM 继续播放，不中断",
      "note": "当前实现无淡入淡出和暂停处理"
    }
  }
}
