{
  "_doc": "背景音乐(BGM)定义。描述每首 BGM 的用途、触发场景、切换逻辑。",
  "playback": {
    "format": "WAV",
    "sampleRate": 44100,
    "loop": "InfiniteLoop（无限循环）",
    "loadStrategy": "on-demand（首次 PlayBGM 时从 assetFS 加载解码）",
    "note": "BGM 文件名不经过 kebabToCamel 转换，直接用原始文件名（去 .wav 后缀）作为查找键"
  },
  "tracks": [
    {
      "file": "bgm-menu.wav",
      "key": "bgm-menu",
      "constant": "BGMMenu",
      "name": "主菜单音乐",
      "description": "在模式选择、选关等非战斗场景播放的背景音乐",
      "triggers": [
        {
          "event": "enterSelectScene",
          "scene": "select",
          "source": "select.go:135",
          "description": "进入模式选择场景时开始播放"
        }
      ],
      "stopsAt": [
        {
          "event": "enterStageScene",
          "description": "进入战斗场景时被 bgm-battle 替换"
        }
      ],
      "mood": "轻松、期待",
      "status": "sf2-generated",
      "note": "WAV 文件存在但可能尚无实际音乐内容"
    },
    {
      "file": "bgm-battle.wav",
      "key": "bgm-battle",
      "constant": "BGMBattle",
      "name": "战斗音乐",
