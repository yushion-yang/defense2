      "triggers": [
        {
          "event": "stageEntry",
          "scene": "stage",
          "source": "stage.go:635",
          "description": "进入战斗场景时开始播放"
        },
        {
          "event": "bossWaveClear",
          "scene": "stage",
          "source": "stage.go:450",
          "description": "Boss 波次结束后，从 bgm-boss 切回 bgm-battle"
        }
      ],
      "stopsAt": [
        {
          "event": "bossWaveStart",
          "description": "Boss 波次开始时被 bgm-boss 替换"
        },
        {
          "event": "victory",
          "source": "stage.go:2114",
          "description": "胜利时停止"
        },
        {
          "event": "defeat",
          "source": "stage.go:2127",
          "description": "失败时停止"
        }
      ],
      "mood": "紧张、节奏感",
      "status": "sf2-generated"
    },
    {
      "file": "bgm-boss.wav",
      "key": "bgm-boss",
      "constant": "BGMBoss",
      "name": "Boss 战斗音乐",
      "description": "Boss 波次期间的专用背景音乐，比普通战斗更紧张激烈",
      "triggers": [
        {
          "event": "bossWaveStart",
          "scene": "stage",
          "source": "stage.go:417",
          "description": "Boss 波次开始时切入",
          "condition": "wave.hasBoss == true"
        }
      ],
      "stopsAt": [
        {
          "event": "bossWaveClear",
          "description": "Boss 波次结束后切回 bgm-battle"
        },
        {
          "event": "victory",
          "description": "胜利时停止"
        },
        {
          "event": "defeat",
          "description": "失败时停止"
        }
