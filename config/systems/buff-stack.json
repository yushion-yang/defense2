{
  "_description": "Buff 堆叠规则规格 — 各 buff 类型的堆叠模式和上限/下限",

  "modes": {
    "strongest":             {"description": "取最强值，不叠加"},
    "additive":              {"description": "多来源值累加"},
    "multiplicative":        {"description": "多来源值相乘"},
    "override":              {"description": "最新覆盖旧值（按优先级）"},
    "independent":           {"description": "各独立计算"},
    "independentPerSource":  {"description": "同来源覆盖，不同来源独立"}
  },

  "rules": {
    "slow":         {"mode": "strongest", "cap": 0.8,  "description": "减速取最强，上限 80%"},
    "stun":         {"mode": "strongest",              "description": "眩晕取最长"},
    "knockup":      {"mode": "strongest",              "description": "击飞取最长"},
    "root":         {"mode": "strongest",              "description": "定身取最长"},
    "silence":      {"mode": "override",               "description": "沉默覆盖"},
    "disarm":       {"mode": "override",               "description": "缴械覆盖"},
    "speedUp":      {"mode": "additive",  "cap": 1.4,  "description": "加速累加，上限 +140%"},
    "damageUp":     {"mode": "additive",  "cap": 3.0,  "description": "增伤累加，上限 +300%"},
    "damageDown":   {"mode": "multiplicative", "floor": 0.2, "description": "减伤相乘，下限 20%"},
    "fireRateUp":   {"mode": "additive",  "cap": 0.5,  "description": "攻速累加，上限 +50%"},
    "invincible":   {"mode": "override",  "priority": 99, "description": "无敌最高优先覆盖"},
    "damageImmune": {"mode": "override",  "priority": 98, "description": "伤害免疫"},
    "controlImmune":{"mode": "override",  "priority": 97, "description": "控制免疫"},
    "slowImmune":   {"mode": "override",  "priority": 95, "description": "减速免疫"},
    "stunImmune":   {"mode": "override",  "priority": 95, "description": "眩晕免疫"},
    "rootImmune":   {"mode": "override",  "priority": 95, "description": "定身免疫"},
    "untargetable": {"mode": "override",  "priority": 96, "description": "不可选中"},
    "dot":          {"mode": "independentPerSource",       "description": "DoT 按来源独立"},
    "tenacity":     {"mode": "additive",  "cap": 1.0,     "description": "韧性累加，上限 100%"}
  }
}
