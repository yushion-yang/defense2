{
  "_description": "Buff 堆叠规则规格 — 各 buff 类型的堆叠模式和上限/下限。权威源: internal/core/buff/stack_rules.go",

  "modes": {
    "strongest":             {"description": "取最强值，不叠加"},
    "additive":              {"description": "多来源值累加"},
    "multiplicative":        {"description": "多来源值相乘"},
    "override":              {"description": "最新覆盖旧值（按优先级）"},
    "independent":           {"description": "各独立计算"},
    "independentPerSource":  {"description": "同来源覆盖，不同来源独立"}
  },

  "rules": {
    "slow":         {"mode": "strongest", "cap": 0.8,  "description": "减速取最强，上限 80%"},
    "stun":         {"mode": "override",               "description": "眩晕覆盖（后来居上）"},
    "knockup":      {"mode": "override",               "description": "击飞覆盖（后来居上）"},
    "silence":      {"mode": "override",               "description": "沉默覆盖"},
    "disarm":       {"mode": "override",               "description": "缴械覆盖"},
    "speedUp":      {"mode": "strongest", "cap": 1.4,  "description": "加速取最强，上限+140%"},
    "damageUp":     {"mode": "additive",  "cap": 3.0,  "description": "增伤累加，上限 +300%"},
    "damageDown":   {"mode": "multiplicative", "floor": 0.2, "description": "减伤相乘，下限 20%。balance.json combat.damageDownFloor is the authoritative value"},
    "fireRateUp":   {"mode": "additive",  "cap": 0.5,  "description": "攻速累加，上限 +50%"},
    "invincible":   {"mode": "override",  "priority": 99,  "description": "无敌最高优先覆盖"},
    "damageImmune": {"mode": "override",  "priority": 90,  "description": "伤害免疫"},
    "controlImmune":{"mode": "override",  "priority": 80,  "description": "控制免疫"},
    "slowImmune":   {"mode": "override",  "priority": 70,  "description": "减速免疫"},
    "stunImmune":   {"mode": "override",  "priority": 70,  "description": "眩晕免疫"},
    "untargetable": {"mode": "override",  "priority": 100, "description": "不可选中（最高优先级）"},
    "shield":       {"mode": "independent",              "description": "护盾各独立计算"},
    "dot":          {"mode": "independentPerSource",     "description": "DoT 按来源独立"},
    "tenacity":     {"mode": "multiplicative",           "description": "韧性乘法叠加（无上限）"},
    "root":         {"mode": "override",                 "description": "定身覆盖（后来居上）"},
    "bleed":        {"mode": "override",                 "description": "流血覆盖（最新覆盖旧值）"},
    "burn":         {"mode": "override",                 "description": "灼烧覆盖（最新覆盖旧值）"},
    "poison":       {"mode": "override",                 "description": "中毒覆盖（最新覆盖旧值）"},
    "weaken":       {"mode": "strongest", "cap": 0.5,    "description": "虚弱取最强，上限 50%"},
    "stealth":      {"mode": "override",                 "description": "隐身覆盖"},
    "phaseShift":   {"mode": "override",                 "description": "相位偏移覆盖"},
    "berserk":      {"mode": "override",                 "description": "狂暴覆盖"},
    "regen":        {"mode": "override",                 "description": "回血覆盖"},
    "healAura":     {"mode": "override",                 "description": "治疗光环覆盖"},
    "bufferAura":   {"mode": "override",                 "description": "旗手光环覆盖"},
    "damageReduce": {"mode": "strongest", "cap": 0.8,    "description": "减伤取最强，上限80%"},
    "aura:damage":      {"mode": "independentPerSource",                 "description": "伤害光环（同源覆盖，不同源叠加）"},
    "aura:pctDamage":   {"mode": "independentPerSource",  "cap": 3.0,    "description": "百分比伤害光环"},
    "aura:pctSpeed":    {"mode": "independentPerSource",  "cap": 2.0,    "description": "百分比攻速光环"},
    "aura:flatRange":   {"mode": "independentPerSource",                 "description": "射程光环（同源覆盖，不同源叠加）"},
    "aura:crit":        {"mode": "independentPerSource",  "cap": 0.8,    "description": "暴击光环"},
    "aura:damageAmp":   {"mode": "independentPerSource",  "cap": 3.0,    "description": "增伤光环"},
    "towerStrength":    {"mode": "override",                 "description": "战灵强度buff"}
  }
}
