//kage:unit pixels

package main

// CenterX, CenterY is the blur origin in pixels (source image coords).
var CenterX float
var CenterY float

// Strength controls the blur amount (0 = off, typical 0.01-0.05).
var Strength float

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	// Direction from this pixel toward the blur center.
	dir := srcPos - vec2(CenterX, CenterY)

	// 8 samples along the radial direction, averaged.
	result := vec4(0)
	for i := 0; i < 8; i++ {
		offset := dir * Strength * (float(i) / 7.0)
		result += imageSrc0At(srcPos - offset)
	}
	return result / 8.0
}
