//kage:unit pixels

package main

// TintR, TintG, TintB define the tint color.
// TintA controls the tint strength (0 = no tint, 1 = fully tinted).
var TintR float
var TintG float
var TintB float
var TintA float

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	src := imageSrc0At(srcPos)
	tint := vec3(TintR, TintG, TintB)
	blended := mix(src.rgb, tint, TintA)
	return vec4(blended, src.a)
}
